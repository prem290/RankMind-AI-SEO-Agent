# RankMind AI Environment Variables

# App Mode
DEMO_MODE=true
ENV=development

# Hindsight Memory Configuration
# Replace with your Hindsight instance details or leave default for local auto-fallback
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# LLM Configuration (Groq or compatible provider)
GROQ_API_KEY=
LLM_MODEL=llama3-70b-8192

# Database Configuration
DATABASE_URL=sqlite:///./rankmind.db
